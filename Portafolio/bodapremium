<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Lucía & Juan - Invitación Premium</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,700;1,400&family=Montserrat:wght@300;400;500;600&display=swap" rel="stylesheet">
    
    <style>
        body {
            margin: 0;
            background-color: #ffffff;
            font-family: 'Montserrat', sans-serif;
            overflow-x: hidden;
            color: #1a1a1a;
        }

        h1, h2, h3, .serif {
            font-family: 'Playfair Display', serif;
        }

        /* --- ESTILO SOBRE ANIMADO --- */
        #envelope-wrapper {
            position: fixed;
            inset: 0;
            z-index: 100;
            display: flex;
            align-items: center;
            justify-content: center;
            background-image: url("https://raw.githubusercontent.com/AdaInvite/AdaInvite/main/Assets/sobreelementos/Textura.jpg");
            background-size: cover;
            transition: opacity 1s ease-in-out, visibility 1s;
        }

        #envelope-container {
            position: relative;
            width: 100vw;
            height: 100vh;
            display: flex;
            align-items: center;
            justify-content: flex-start;
            overflow: hidden;
        }

        .flap-container {
            position: absolute;
            width: 100%;
            height: 100%;
            filter: drop-shadow(0px 0px 20px rgba(0,0,0,0.15));
            z-index: 5;
        }

        .flap {
            position: absolute;
            top: 0;
            width: 60%; 
            height: 100%;
            background-image: url("https://raw.githubusercontent.com/AdaInvite/AdaInvite/main/Assets/sobreelementos/Textura.jpg");
            background-size: cover;
            background-repeat: no-repeat;
            transition: transform 1.8s cubic-bezier(0.7, 0, 0.3, 1);
        }

        .flap-left {
            left: 0;
            clip-path: polygon(0 0, 100% 50%, 0 100%);
            border-right: 1.5px solid rgba(0,0,0,0.08);
        }

        #envelope-container.open .flap-left {
            transform: translateX(-100%);
        }

        #envelope-wrapper.hidden-envelope {
            opacity: 0;
            visibility: hidden;
            pointer-events: none;
        }

        .seal-wrapper {
            position: absolute;
            top: 50%; 
            left: 60%; 
            transform: translate(-50%, -50%);
            z-index: 10;
            display: flex;
            flex-direction: column;
            align-items: center;
            cursor: pointer;
        }

        .click-hint {
            color: #000;
            font-size: 10px;
            letter-spacing: 2px;
            margin-bottom: 10px;
            text-transform: uppercase;
            font-weight: 700;
            animation: bounce-subtle 2s infinite;
        }

        @keyframes bounce-subtle {
            0%, 100% { transform: translateY(0); }
            50% { transform: translateY(-5px); }
        }

        @keyframes floating {
            0%, 100% { transform: translateY(0px) rotate(0deg); }
            50% { transform: translateY(-10px) rotate(2deg); }
        }

        /* --- ESTILO INVITACIÓN PREMIUM --- */
        .main-content {
            opacity: 0;
            transition: opacity 1s ease-in;
            background: white;
            max-width: 480px;
            margin: 0 auto;
            min-height: 100vh;
            box-shadow: 0 0 50px rgba(0,0,0,0.05);
        }

        .main-content.visible {
            opacity: 1;
        }

        .img-bw {
            filter: grayscale(100%);
            width: 100%;
            display: block;
        }

        /* --- ANIMACIÓN SCROLL --- */
        .reveal {
            opacity: 0;
            transform: translateY(30px);
            transition: all 1.2s ease-out;
        }

        .reveal.active {
            opacity: 1;
            transform: translateY(0);
        }

        /* --- CRONOGRAMA CENTRADO --- */
        .timeline-container {
            position: relative;
            max-width: 300px;
            margin: 0 auto;
        }

        .timeline-item {
            position: relative;
            padding-bottom: 40px;
            display: flex;
            flex-direction: column;
            align-items: center;
            text-align: center;
        }

        .timeline-item::after {
            content: '';
            position: absolute;
            bottom: 0;
            left: 50%;
            transform: translateX(-50%);
            width: 1px;
            height: 30px;
            background: #eee;
        }

        .timeline-item:last-child::after {
            display: none;
        }

        .timeline-dot {
            width: 9px;
            height: 9px;
            background: #000;
            border-radius: 50%;
            margin-bottom: 15px;
        }

        /* --- GALERÍA HORIZONTAL --- */
        .gallery-scroll {
            display: flex;
            overflow-x: auto;
            scroll-snap-type: x mandatory;
            gap: 10px;
            padding: 20px;
            scrollbar-width: none;
        }
        .gallery-scroll::-webkit-scrollbar {
            display: none;
        }
        .gallery-item {
            flex: 0 0 85%;
            scroll-snap-align: center;
            border-radius: 4px;
            overflow: hidden;
        }

        /* --- FORMULARIO RSVP --- */
        .rsvp-form input, .rsvp-form select, .rsvp-form textarea {
            width: 100%;
            padding: 12px;
            margin-bottom: 15px;
            border: 1px solid #e5e5e5;
            border-radius: 4px;
            font-size: 14px;
            font-family: 'Montserrat', sans-serif;
        }
        .rsvp-form input:focus {
            outline: none;
            border-color: #000;
        }

        .date-display {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 20px;
            border-top: 1px solid #eee;
            border-bottom: 1px solid #eee;
            padding: 20px 0;
            margin: 30px auto;
            width: 85%;
        }

        .date-display span {
            font-size: 10px;
            text-transform: uppercase;
            letter-spacing: 3px;
            color: #333;
        }

        .date-display .big-day {
            font-size: 2.2rem;
            font-weight: 400;
        }

        /* --- BOTONES --- */
        .btn-memories {
            background-color: black;
            color: white;
            padding: 12px 35px;
            border-radius: 999px;
            font-size: 10px;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 2px;
            display: inline-block;
            transition: all 0.3s;
            cursor: pointer;
            border: none;
        }

        /* --- MÚSICA --- */
        #music-control {
            position: fixed;
            bottom: 20px;
            right: 20px;
            z-index: 50;
            background: rgba(255,255,255,0.8);
            backdrop-filter: blur(5px);
            width: 45px;
            height: 45px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            box-shadow: 0 4px 15px rgba(0,0,0,0.1);
            opacity: 0;
            transition: opacity 0.5s;
        }
        
        #music-control.visible {
            opacity: 1;
        }

        .music-bars {
            display: flex;
            align-items: flex-end;
            gap: 2px;
            height: 15px;
        }

        .bar {
            width: 3px;
            background: black;
            height: 100%;
            animation: music-bar 1s infinite ease-in-out;
            border-radius: 1px;
        }
        
        .paused .bar {
            animation-play-state: paused;
            height: 3px;
        }

        @keyframes music-bar {
            0%, 100% { height: 5px; }
            50% { height: 15px; }
        }
    </style>
</head>
<body>

    <!-- MÚSICA -->
    <audio id="bg-music" loop>
        <source src="https://www.soundhelix.com/examples/mp3/SoundHelix-Song-1.mp3" type="audio/mpeg">
    </audio>

    <div id="music-control" onclick="toggleMusic()">
        <div id="music-bars-container" class="music-bars paused">
            <div class="bar" style="animation-delay: 0s"></div>
            <div class="bar" style="animation-delay: 0.2s"></div>
            <div class="bar" style="animation-delay: 0.4s"></div>
        </div>
    </div>

    <!-- SOBRE ANIMADO -->
    <div id="envelope-wrapper">
        <div id="envelope-container">
            <div class="flap-container">
                <div class="flap flap-left"></div>
            </div>
            <div class="seal-wrapper" onclick="openEnvelope()">
                <div class="click-hint">Abrir Invitación</div>
                <img src="https://raw.githubusercontent.com/AdaInvite/AdaInvite/main/Assets/%C3%8Dtems%20boda%20negro/Sello%20plata%20flor.png" 
                     style="width:90px; animation: floating 4s infinite ease-in-out" 
                     alt="Sello">
            </div>
        </div>
    </div>

    <!-- CONTENIDO PREMIUM -->
    <div id="invitation-content" class="main-content">
        
        <!-- SECCIÓN 1: PORTADA -->
        <header class="bg-white text-center">
            <div class="h-[70vh] overflow-hidden">
                <img src="https://raw.githubusercontent.com/AdaInvite/AdaInvite/main/Assets/sesionpreboda/Hero%20foto.png" 
                     alt="Hero" class="img-bw w-full h-full object-cover">
            </div>
            <div class="pt-2 pb-12 px-6 -mt-10 relative z-10 reveal active">
                <p class="uppercase tracking-[0.4em] text-[10px] mb-6 font-medium text-gray-400">Nos Casamos</p>
                <h1 class="text-3xl italic serif mb-6 font-light text-black leading-tight">
                    Lucía<br>&<br>Juan
                </h1>
                <p class="text-[13px] tracking-[0.2em] text-black font-semibold">29 . 11 . 2026</p>
            </div>
        </header>

        <!-- SECCIÓN 2: COUNTDOWN & FRASE -->
        <section class="bg-white pt-20 reveal text-center">
            <p class="uppercase tracking-[0.3em] text-[11px] text-gray-800 mb-8 font-semibold">Faltan:</p>
            <div id="timer" class="flex justify-center gap-8 mb-12">
                <div class="flex flex-col"><span id="days" class="text-3xl font-light">000</span><span class="text-[10px] uppercase tracking-widest text-gray-400">Días</span></div>
                <div class="flex flex-col"><span id="hours" class="text-3xl font-light">00</span><span class="text-[10px] uppercase tracking-widest text-gray-400">horas</span></div>
                <div class="flex flex-col"><span id="minutes" class="text-3xl font-light">00</span><span class="text-[10px] uppercase tracking-widest text-gray-400">minutos</span></div>
                <div class="flex flex-col"><span id="seconds" class="text-3xl font-light">00</span><span class="text-[10px] uppercase tracking-widest text-gray-400">segundos</span></div>
            </div>
            <div class="px-10">
                <p class="text-[16px] text-gray-500 italic leading-relaxed">
                    "Nuestra historia suma un nuevo capítulo y no sería lo mismo sin ti. ¡Acompáñanos a celebrar el inicio de nuestro para siempre!"
                </p>
            </div>
            <div class="date-display">
                <span>Domingo</span>
                <span class="big-day">29</span>
                <span>Noviembre</span>
            </div>
        </section>

        <!-- SECCIÓN 3: UBICACIONES -->
        <section class="reveal text-center py-16 px-6">
            <div class="mb-20">
                <img src="https://raw.githubusercontent.com/AdaInvite/AdaInvite/main/Assets/%C3%8Dtems%20boda%20negro/Iglesia%20negro%20ceremonia.png" class="w-14 mx-auto mb-6" alt="Icono">
                <h3 class="text-2xl serif mb-4">Ceremonia</h3>
                <p class="text-[14px] text-gray-500 mb-8">21:30 hs - Parroquia Nuestra Señora de Lourdes.<br>Calle Reforma 123.</p>
                <a href="https://maps.google.com" target="_blank" class="btn-memories">Cómo llegar</a>
            </div>
            <div>
                <img src="https://raw.githubusercontent.com/AdaInvite/AdaInvite/main/Assets/%C3%8Dtems%20boda%20negro/Copas%20negro.png" class="w-14 mx-auto mb-6" alt="Icono">
                <h3 class="text-2xl serif mb-4">Fiesta</h3>
                <p class="text-[14px] text-gray-500 mb-8">21:30 hs - Salón Vista Hermosa.<br>Av. del Sol 456.</p>
                <a href="https://maps.google.com" target="_blank" class="btn-memories">Cómo llegar</a>
            </div>
        </section>

        <!-- SECCIÓN 4: CRONOGRAMA -->
        <section class="bg-[#fafafa] py-20 px-12 reveal text-center">
            <h3 class="text-3xl serif mb-12">Cronograma</h3>
            <div class="timeline-container">
                <div class="timeline-item">
                    <div class="timeline-dot"></div>
                    <img src="https://raw.githubusercontent.com/AdaInvite/AdaInvite/main/Assets/%C3%8Dtems%20boda%20negro/Copas%20negro%20recepci%C3%B3n.png" class="w-8 mb-2" alt="Icono">
                    <p class="font-bold text-sm">21:30 Hs</p>
                    <p class="text-xs text-gray-500">Toma tu lugar</p>
                </div>
                <div class="timeline-item">
                    <div class="timeline-dot"></div>
                    <img src="https://raw.githubusercontent.com/AdaInvite/AdaInvite/main/Assets/%C3%8Dtems%20boda%20negro/Vals%20negro.png" class="w-8 mb-2" alt="Icono">
                    <p class="font-bold text-sm">22:30 Hs</p>
                    <p class="text-xs text-gray-500">Brindis & Vals</p>
                </div>
                <div class="timeline-item">
                    <div class="timeline-dot"></div>
                    <img src="https://raw.githubusercontent.com/AdaInvite/AdaInvite/main/Assets/%C3%8Dtems%20boda%20negro/Pastel%20negro.png" class="w-8 mb-2" alt="Icono">
                    <p class="font-bold text-sm">23:30 Hs</p>
                    <p class="text-xs text-gray-500">Corte de Pastel</p>
                </div>
                <div class="timeline-item">
                    <div class="timeline-dot"></div>
                    <img src="https://raw.githubusercontent.com/AdaInvite/AdaInvite/main/Assets/%C3%8Dtems%20boda%20negro/Baile%20negro.png" class="w-8 mb-2" alt="Icono">
                    <p class="font-bold text-sm">00:00 Hs</p>
                    <p class="text-xs text-gray-500">¡A bailar!</p>
                </div>
            </div>
        </section>

        <!-- SECCIÓN 5: GALERÍA INTERACTIVA HORIZONTAL -->
        <section class="reveal text-center py-16">
            <h3 class="text-3xl serif mb-4">Momentos</h3>
            <p class="text-xs text-gray-400 mb-8 uppercase tracking-widest italic">Desliza para ver más</p>
            <div class="gallery-scroll">
                <div class="gallery-item">
                    <img src="https://raw.githubusercontent.com/AdaInvite/AdaInvite/main/Assets/sesionpreboda/sesi%C3%B3npreboda2.png" class="img-bw h-96 object-cover" alt="Foto">
                </div>
                <div class="gallery-item">
                    <img src="https://raw.githubusercontent.com/AdaInvite/AdaInvite/main/Assets/sesionpreboda/sesi%C3%B3npreboda3.png" class="img-bw h-96 object-cover" alt="Foto">
                </div>
                <div class="gallery-item">
                    <img src="https://raw.githubusercontent.com/AdaInvite/AdaInvite/main/Assets/sesionpreboda/sesi%C3%B3npreboda5.png" class="img-bw h-96 object-cover" alt="Foto">
                </div>
                <div class="gallery-item">
                    <img src="https://raw.githubusercontent.com/AdaInvite/AdaInvite/main/Assets/sesionpreboda/sesi%C3%B3npreboda6.png" class="img-bw h-96 object-cover" alt="Foto">
                </div>
                <div class="gallery-item">
                    <img src="https://raw.githubusercontent.com/AdaInvite/AdaInvite/main/Assets/sesionpreboda/sesi%C3%B3npreboda4.png" class="img-bw h-96 object-cover" alt="Foto">
                </div>
            </div>
        </section>

        <!-- SECCIÓN 6: DRESS CODE -->
        <section class="reveal text-center py-16 px-6">
            <img src="https://raw.githubusercontent.com/AdaInvite/AdaInvite/main/Assets/%C3%8Dtems%20boda%20negro/Dress%20code%20negro.png" class="w-16 mx-auto mb-6" alt="Icono">
            <h3 class="text-2xl serif mb-4">Dress Code</h3>
            <p class="text-[14px] uppercase tracking-widest mb-4 font-bold">Formal</p>
            <p class="text-[14px] text-gray-400 italic">Nos encantará verte lucir tu mejor gala.</p>
        </section>

        <!-- SECCIÓN 7: MESA DE REGALOS -->
        <section class="bg-[#fafafa] py-20 reveal text-center">
            <img src="https://raw.githubusercontent.com/AdaInvite/AdaInvite/main/Assets/%C3%8Dtems%20boda%20negro/Regalo%20negro.png" class="w-16 mx-auto mb-8" alt="Regalo">
            <h3 class="text-2xl serif mb-10">Mesa de Regalos</h3>
            <div class="flex flex-col gap-12 items-center grayscale">
                <a href="https://www.amazon.com.mx" target="_blank"><img src="https://raw.githubusercontent.com/AdaInvite/AdaInvite/main/Assets/%C3%8Dtems%20boda%20negro/Amazon.png" class="h-16" alt="Amazon"></a>
                <a href="https://www.liverpool.com.mx" target="_blank"><img src="https://raw.githubusercontent.com/AdaInvite/AdaInvite/main/Assets/%C3%8Dtems%20boda%20negro/Liverpool.png" class="h-12" alt="Liverpool"></a>
            </div>
        </section>

        <!-- SECCIÓN 8: RSVP FORMULARIO -->
        <section class="pb-32 reveal text-center px-8">
            <h3 class="text-3xl serif mb-8 italic">¿Nos acompañas?</h3>
            <p class="text-[12px] text-gray-400 mb-10 uppercase tracking-widest">Favor de confirmar antes del 1 de Noviembre</p>
            
            <form id="rsvp-form" class="rsvp-form text-left">
                <label class="text-[10px] uppercase font-bold tracking-widest block mb-2">Nombre Completo</label>
                <input type="text" id="name" placeholder="Escribe tu nombre" required>

                <label class="text-[10px] uppercase font-bold tracking-widest block mb-2">¿Asistirás?</label>
                <select id="attendance" required>
                    <option value="Si">Sí, ¡con gusto!</option>
                    <option value="No">No podré asistir</option>
                </select>

                <label class="text-[10px] uppercase font-bold tracking-widest block mb-2">Número de acompañantes</label>
                <input type="number" id="guests" min="0" max="5" value="0">

                <label class="text-[10px] uppercase font-bold tracking-widest block mb-2">Restricciones Alimentarias / Comentarios</label>
                <textarea id="comments" rows="3" placeholder="Alergias, vegetariano, etc."></textarea>

                <div class="text-center mt-6">
                    <button type="submit" class="btn-memories w-full">Confirmar por WhatsApp</button>
                </div>
            </form>

            <div class="mt-40">
                <img src="https://raw.githubusercontent.com/AdaInvite/AdaInvite/main/Assets/sesionpreboda/sesi%C3%B3npreboda7.png" class="w-24 h-24 mx-auto rounded-full img-bw border border-gray-100 object-cover mb-8" alt="Novios">
                <p class="text-[10px] uppercase tracking-[0.5em] text-gray-300">DISEÑO MEMORIES</p>
            </div>
        </section>

    </div>

    <script>
        const audio = document.getElementById('bg-music');
        const musicControl = document.getElementById('music-control');
        const bars = document.getElementById('music-bars-container');

        function openEnvelope() {
            document.getElementById('envelope-container').classList.add('open');
            setTimeout(() => {
                document.getElementById('envelope-wrapper').classList.add('hidden-envelope');
                document.getElementById('invitation-content').classList.add('visible');
                document.body.style.overflow = "auto";
                musicControl.classList.add('visible');
                audio.play().catch(() => console.log("Auto-play blocked"));
                bars.classList.remove('paused');
                reveal();
            }, 1200);
        }

        function toggleMusic() {
            if (audio.paused) { audio.play(); bars.classList.remove('paused'); } 
            else { audio.pause(); bars.classList.add('paused'); }
        }

        function reveal() {
            const reveals = document.querySelectorAll(".reveal");
            for (let i = 0; i < reveals.length; i++) {
                const windowHeight = window.innerHeight;
                const elementTop = reveals[i].getBoundingClientRect().top;
                if (elementTop < windowHeight - 100) { reveals[i].classList.add("active"); }
            }
        }

        // Lógica del Formulario RSVP
        document.getElementById('rsvp-form').addEventListener('submit', function(e) {
            e.preventDefault();
            const name = document.getElementById('name').value;
            const attendance = document.getElementById('attendance').value;
            const guests = document.getElementById('guests').value;
            const comments = document.getElementById('comments').value;

            const message = `Hola Lucía y Juan! Confirmación de invitación:
Nombre: ${name}
Asistencia: ${attendance}
Acompañantes: ${guests}
Comentarios: ${comments}`;

            const encodedMessage = encodeURIComponent(message);
            window.open(`https://wa.me/521234567890?text=${encodedMessage}`, '_blank');
        });

        window.addEventListener("scroll", reveal);
        const targetDate = new Date("Nov 29, 2026 21:30:00").getTime();
        setInterval(() => {
            const now = new Date().getTime();
            const diff = targetDate - now;
            if (diff < 0) return;
            document.getElementById("days").innerText = Math.floor(diff / (1000 * 60 * 60 * 24));
            document.getElementById("hours").innerText = Math.floor((diff % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
            document.getElementById("minutes").innerText = Math.floor((diff % (1000 * 60 * 60)) / (1000 * 60));
            document.getElementById("seconds").innerText = Math.floor((diff % (1000 * 60)) / 1000);
        }, 1000);
        document.body.style.overflow = "hidden";
    </script>
</body>
</html>