<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Valentina - XV Años Premium</title>
    
    <!-- Iconos -->
    <link rel="icon" type="image/png" href="https://raw.githubusercontent.com/AdaInvite/AdaInvite/main/Logo%20AdaInvite.png">
    <link rel="apple-touch-icon" href="https://raw.githubusercontent.com/AdaInvite/AdaInvite/main/Logo%20AdaInvite.png">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="default">
    <meta name="apple-mobile-web-app-title" content="AdaInvite">
    <meta name="theme-color" content="#000000">

    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Fuentes: Great Vibes (Cursiva elegante), Cinzel (Lujo), Montserrat (Cuerpo) -->
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;700&family=Montserrat:wght@200;300;400;600&family=Great+Vibes&display=swap" rel="stylesheet">
    
    <style>
        :root {
            --accent-yellow: #fef08a; /* Amarillo Pastel */
            --silver: #cbd5e1;       
            --glass: rgba(255, 255, 255, 0.05);
            --glass-border: rgba(255, 255, 255, 0.1);
        }

        body {
            font-family: 'Montserrat', sans-serif;
            background-color: #000000;
            color: #ffffff;
            margin: 0;
            overflow: hidden; 
        }

        /* Tipografías */
        .font-title { font-family: 'Great Vibes', cursive; }
        .font-subtitle { font-family: 'Cinzel', serif; }
        .font-body { font-family: 'Montserrat', sans-serif; }

        /* --- SOBRE ANIMADO --- */
        #envelope-container {
            position: fixed;
            inset: 0;
            width: 100vw;
            height: 100vh;
            display: flex;
            align-items: center;
            justify-content: flex-start;
            overflow: hidden;
            z-index: 3000;
            background-image: url("https://github.com/AdaInvite/AdaInvite/blob/main/Assets/sobreelementos/Textura.jpg?raw=true");
            background-size: cover;
            background-repeat: no-repeat;
            background-position: center;
            transition: opacity 1s ease-in-out, visibility 1s;
        }

        .flap-container {
            position: absolute;
            width: 100%;
            height: 100%;
            filter: drop-shadow(0px 0px 20px rgba(0,0,0,0.2));
            z-index: 5;
        }

        .flap {
            position: absolute;
            top: 0;
            width: 60%;
            height: 100%;
            background-image: url("https://github.com/AdaInvite/AdaInvite/blob/main/Assets/sobreelementos/Textura.jpg?raw=true");
            background-size: cover;
            background-repeat: no-repeat;
            transition: transform 1.8s cubic-bezier(0.7, 0, 0.3, 1);
        }

        .flap-left {
            left: 0;
            clip-path: polygon(0 0, 100% 50%, 0 100%);
            border-right: 1.5px solid rgba(0,0,0,0.1);
        }

        #envelope-container.open .flap-left { transform: translateX(-100%); }
        #envelope-container.open .seal-wrapper { opacity: 0; transform: scale(0.5); pointer-events: none; }
        #envelope-container.open { opacity: 0; visibility: hidden; }

        .seal-wrapper {
            position: absolute;
            top: 50%; left: 60%; transform: translate(-50%, -50%);
            z-index: 10;
            display: flex;
            flex-direction: column;
            align-items: center;
            cursor: pointer;
            transition: all 0.5s ease;
        }

        .click-hint {
            color: #000000;
            font-family: 'Cinzel', serif; 
            font-size: 9px;
            letter-spacing: 3px;
            margin-bottom: 10px;
            text-transform: uppercase;
            font-weight: 700;
            animation: bounce-subtle 2s infinite;
        }

        /* --- PORTADA SPLASH (REGINA STYLE) --- */
        .bg-new-cover {
            background-image: linear-gradient(to bottom, rgba(0,0,0,0.2), rgba(0,0,0,0.5)), 
                              url('https://github.com/AdaInvite/AdaInvite/blob/main/Assets/xvgoticobarroco/descarga%20(12).jpg?raw=true');
            background-size: cover;
            background-position: center;
        }

        .save-the-date-side {
            position: absolute;
            left: 10px;
            top: 50%;
            transform: rotate(-90deg) translateX(50%);
            transform-origin: left top;
            font-family: 'Great Vibes', cursive;
            font-size: 28px;
            color: rgba(255, 255, 255, 0.7);
            white-space: nowrap;
            letter-spacing: 2px;
        }

        .date-separator {
            width: 1px;
            height: 60px;
            background: rgba(255, 255, 255, 0.5);
        }

        /* --- REVEAL ANIMATIONS --- */
        .reveal { opacity: 0; transform: translateY(40px); transition: all 1s cubic-bezier(0.2, 0.8, 0.2, 1); }
        .reveal.active { opacity: 1; transform: translateY(0); }

        .glass { background: var(--glass); backdrop-filter: blur(15px); border: 1px solid var(--glass-border); }

        .btn-premium {
            background: transparent;
            border: 1px solid var(--accent-yellow);
            color: var(--accent-yellow);
            transition: all 0.4s ease;
            position: relative;
            z-index: 1;
        }
        .btn-premium:hover { color: #000000; background: var(--accent-yellow); }

        /* Historia Slider */
        .story-slider { display: flex; overflow-x: auto; scroll-snap-type: x mandatory; gap: 20px; padding: 20px 0; scrollbar-width: none; }
        .story-slider::-webkit-scrollbar { display: none; }
        .story-card { flex: 0 0 85%; scroll-snap-align: center; }
        @media (min-width: 768px) { .story-card { flex: 0 0 45%; } }

        /* Itinerario Line */
        .itinerary-container { position: relative; }
        .timeline-line {
            position: absolute;
            top: 40px;
            bottom: 40px;
            left: 50%;
            width: 2px;
            background: linear-gradient(to bottom, transparent, var(--silver), transparent);
            transform: translateX(-50%);
            z-index: 0;
        }
        @media (max-width: 768px) { .timeline-line { left: 30px; transform: none; } }

        .itinerary-icon {
            width: 65px;
            height: 65px;
            background: #ffffff;
            border-radius: 50%;
            padding: 12px;
            margin: 0 auto;
            display: flex;
            align-items: center;
            justify-content: center;
            position: relative;
            z-index: 1;
            box-shadow: 0 0 20px rgba(255, 255, 255, 0.15);
            border: 2px solid var(--accent-yellow);
        }

        .music-header { position: fixed; top: 30px; right: 30px; z-index: 2000; display: none; align-items: center; gap: 15px; background: rgba(0,0,0,0.6); padding: 10px 18px; border-radius: 50px; border: 1px solid var(--glass-border); cursor: pointer; }
        .visualizer { display: flex; align-items: flex-end; gap: 3px; height: 14px; }
        .v-bar { width: 2px; background: var(--accent-yellow); animation: bounce 1s ease-in-out infinite; }

        input, select, textarea {
            background: rgba(255,255,255,0.05);
            border: 1px solid rgba(255,255,255,0.1);
            color: white;
            padding: 14px;
            border-radius: 12px;
            width: 100%;
            outline: none;
            transition: all 0.3s ease;
        }
        input:focus, select:focus, textarea:focus {
            border-color: var(--accent-yellow);
            background: rgba(255,255,255,0.12);
        }

        @keyframes bounce-subtle { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-5px); } }
        @keyframes floating { 0%, 100% { transform: translateY(0px) rotate(0deg); } 50% { transform: translateY(-15px) rotate(2deg); } }
    </style>
</head>
<body class="bg-black">

    <!-- SOBRE ANIMADO -->
