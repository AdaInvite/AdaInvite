        <!-- RSVP FORMULARIO -->
        <section class="py-24 px-6 max-w-3xl mx-auto">
            <div class="reveal glass p-10 md:p-20 space-y-12 border-white/10 shadow-2xl rounded-3xl">
                <div class="text-center space-y-4">
                    <h3 class="font-title text-4xl text-white">¿Me Acompañas?</h3>
                    <p class="font-subtitle text-yellow-200 text-[10px] uppercase tracking-[0.5em]">Formulario de Asistencia</p>
                </div>
                
                <form id="premiumRSVP" class="space-y-10 font-body">
                    <div class="space-y-3">
                        <label class="text-[9px] uppercase tracking-[0.3em] text-slate-400 font-bold">Nombre Completo</label>
                        <input type="text" id="guestName" required placeholder="Tu nombre y apellido">
                    </div>

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-10">
                        <div class="space-y-3">
                            <label class="text-[9px] uppercase tracking-[0.3em] text-slate-400 font-bold">Adultos</label>
                            <select id="adultsCount">
                                <option value="1">1 Persona</option>
                                <option value="2">2 Personas</option>
                                <option value="3">3 Personas</option>
                                <option value="4">4 Personas</option>
                            </select>
                        </div>
                        <div class="space-y-3">
                            <label class="text-[9px] uppercase tracking-[0.3em] text-slate-400 font-bold">Niños</label>
                            <select id="kidsCount">
                                <option value="0">Ninguno</option>
                                <option value="1">1 Niño</option>
                                <option value="2">2 Niños</option>
                            </select>
                        </div>
                    </div>

                    <div class="space-y-3">
                        <label class="text-[9px] uppercase tracking-[0.3em] text-slate-400 font-bold">Notas o Alergias</label>
                        <textarea id="guestNotes" rows="2" placeholder="Ej: Vegetariano, alergia a mariscos..."></textarea>
                    </div>

                    <button type="submit" class="w-full btn-premium py-6 font-subtitle rounded-2xl uppercase tracking-[0.4em] text-[11px] font-bold shadow-xl shadow-yellow-400/5 transition-all active:scale-95">Confirmar mi Lugar</button>
                </form>
            </div>
        </section>

        <footer class="py-32 text-center opacity-20"><p class="font-subtitle text-[10px] tracking-[0.8em] uppercase">VALENTINA 2026 • EVENTO PRIVADO</p></footer>
    </main>

    <script>
        const audio = document.getElementById('bgMusic');
        const backToTop = document.getElementById('back-to-top');

        function openEnvelope() { 
            document.getElementById('envelope-container').classList.add('open'); 
        }

        function startExperience() {
            const cover = document.getElementById('cover');
            const content = document.getElementById('main-content');
            audio.play().catch(e => console.log("Audio block"));
            document.getElementById('integrated-music').style.display = 'flex';
            cover.classList.add('screen-up');
            setTimeout(() => {
                cover.style.display = 'none';
                content.classList.remove('hidden');
                document.body.style.overflow = 'auto';
                setTimeout(() => { content.classList.add('opacity-100'); handleScroll(); }, 50);
            }, 1000);
        }

        function toggleMusic() { if (audio.paused) { audio.play(); } else { audio.pause(); } }
        function scrollToTop() { window.scrollTo({ top: 0, behavior: 'smooth' }); }

        function handleScroll() {
            const reveals = document.querySelectorAll('.reveal');
            reveals.forEach(reveal => { if (reveal.getBoundingClientRect().top < window.innerHeight - 100) { reveal.classList.add('active'); } });
            if (window.scrollY > 600) { backToTop.style.display = 'flex'; setTimeout(() => backToTop.style.opacity = '1', 10); } 
            else { backToTop.style.opacity = '0'; setTimeout(() => backToTop.style.display = 'none', 300); }
        }
        window.addEventListener('scroll', handleScroll);

        const eventTime = new Date('June 24, 2026 20:00:00').getTime();
        function updateTimer() {
            const diff = eventTime - new Date().getTime();
            if (diff <= 0) return;
            document.getElementById('days').innerText = Math.floor(diff / 86400000).toString().padStart(2, '0');
            document.getElementById('hours').innerText = Math.floor((diff % 86400000) / 3600000).toString().padStart(2, '0');
            document.getElementById('minutes').innerText = Math.floor((diff % 3600000) / 60000).toString().padStart(2, '0');
            document.getElementById('seconds').innerText = Math.floor((diff % 60000) / 1000).toString().padStart(2, '0');
        }
        setInterval(updateTimer, 1000);
        updateTimer();

        document.getElementById('premiumRSVP').addEventListener('submit', function(e) {
            e.preventDefault();
            const name = document.getElementById('guestName').value;
            const adults = document.getElementById('adultsCount').value;
            const kids = document.getElementById('kidsCount').value;
            const notes = document.getElementById('guestNotes').value || "Ninguna";
            const message = `¡Hola Valentina! Confirmo mi asistencia.\n👤 Nombre: ${name}\n👨 Adultos: ${adults}\n🧒 Niños: ${kids}\n📝 Notas: ${notes}`;
            window.open(`https://wa.me/1234567890?text=${encodeURIComponent(message)}`, '_blank');
        });
    </script>
</body>
</html>