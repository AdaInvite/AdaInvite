export async function onRequestPost(context) {
  try {
    const request = context.request;
    const env = context.env; 

    const formData = await request.formData();
    const file = formData.get('file');

    if (!file) return new Response('No se encontró el archivo', { status: 400 });

    const filename = `${Date.now()}-${file.name}`;

    // Guarda en R2 usando el binding que configuraremos en Cloudflare
    await env.BUCKET_FOTOS.put(filename, file.stream(), {
      httpMetadata: { contentType: file.type },
    });

    const publicUrl = `https://fotos.adainvite.com/${filename}`;
    
    return new Response(JSON.stringify({ url: publicUrl }), {
      headers: { 'Content-Type': 'application/json' }
    });
  } catch (error) {
    return new Response(error.message, { status: 500 });
  }
}